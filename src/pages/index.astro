---
import StudyLayout from '../layouts/StudyLayout.astro';
import { exams } from '../data/exams.js';
---
<StudyLayout title="Inicio">
  <main class="frame catalog">
    <h1>Cuestionarios de estudio</h1>
    <ul class="exam-list">
      {exams.map(exam => <li><a href={`/${exam.course}/${exam.slug}/`}>{exam.courseName} · {exam.title}</a><span>{exam.questions.length} preguntas</span></li>)}
    </ul>
  </main>
</StudyLayout>
